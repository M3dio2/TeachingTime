# Copy to .env.local and fill in. Never commit .env.local.

# LiveKit Cloud (project settings → API keys)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase (Project Settings → API Keys). Legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (sign-up / login check). Optional: without it the forms show no CAPTCHA.
# Local testing: 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Test teacher account for the browser tests (npm run test:e2e). Never a real teacher.
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
